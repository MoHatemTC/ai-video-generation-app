# Copy this file to .env for local development.
# Do not commit .env.

APP_NAME=Sprints Video Studio
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# Database
# Start with SQLite for internship learning. PostgreSQL can be added later.
DATABASE_URL=sqlite:///./video_studio.db

# LLM provider (transcript + scene planner agents)
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Text-to-speech (voiceover)
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE=

# Alignment / timestamped transcription
# e.g. a local Whisper/WhisperX model or a hosted STT API
ALIGNMENT_MODEL=
ALIGNMENT_API_KEY=

# Asset sourcing / generation
IMAGE_PROVIDER=
IMAGE_API_KEY=

# Object/file storage for assets and rendered videos
STORAGE_DIR=./storage
